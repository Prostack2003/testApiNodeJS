{
    "compilerOptions": {
        "noEmit": true,
        "target": "ES2022",
        "module": "commonjs",
        "strict": true,
        "rootDir": "./src",
        "outDir": "dist",
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": false,
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}

